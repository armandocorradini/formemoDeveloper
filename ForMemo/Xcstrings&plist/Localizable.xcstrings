    "Set Password Expiration" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwortablauf festlegen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer la caducidad de la contraseña"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
