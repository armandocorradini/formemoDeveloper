        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere das automatische Ausfüllen: Öffne Einstellungen > Allgemein > Automatisches Ausfüllen und Passwörter und deaktiviere ForMemo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desactivar Autorrelleno, ve a Ajustes IOS  > General > Autorrelleno y contraseñas y desactiva ForMemo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver le remplissage automatique : accédez à Réglages > Général > Remplissage automatique et mots de passe, puis désactivez ForMemo."
