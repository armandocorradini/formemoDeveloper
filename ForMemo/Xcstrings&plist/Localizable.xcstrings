            "value" : "Nur Anhänge abgeschlossener Aufgaben werden automatisch gelöscht, wenn die Option in den Einstellungen aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los archivos adjuntos de tareas completadas se eliminan automáticamente si la opción está activada en los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les pièces jointes des tâches terminées sont supprimées automatiquement si l’option est activée dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo gli allegati delle attività completate vengono eliminati automaticamente se l’opzione è attiva nelle impostazioni"
          }
        }
