    "%@ can be opened automatically at launch. Choose a specific startup tab in General before hiding it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann beim Start automatisch geöffnet werden. Wähle unter „Allgemein“ einen bestimmten Start-Tab aus, bevor du diesen Tab ausblendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede abrirse automáticamente al iniciar la app. Elige una pestaña de inicio específica en General antes de ocultarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut être ouvert automatiquement au démarrage. Choisissez un onglet de démarrage spécifique dans Général avant de le masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ può essere aperto automaticamente all’avvio. Scegli una tab di avvio specifica in Generali prima di nasconderla."
          }
        }
      }
    },
    "%@ is hidden. Make it visible in Tab Visibility before setting it as the startup tab." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ausgeblendet. Blende den Tab unter „Tab-Sichtbarkeit“ ein, bevor du ihn als Start-Tab festlegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está oculta. Hazla visible en Visibilidad de pestañas antes de establecerla como pestaña de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est masqué. Rendez-le visible dans Visibilité des onglets avant de le définir comme onglet de démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è nascosta. Rendila visibile in Visibilità tab prima di impostarla come tab di avvio."
          }
        }
      }
    },
    "%@ is set as the startup tab. Choose another startup tab in General before hiding it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist als Start-Tab festgelegt. Wähle unter „Allgemein“ einen anderen Start-Tab aus, bevor du diesen Tab ausblendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está establecida como pestaña de inicio. Elige otra pestaña de inicio en General antes de ocultarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est défini comme onglet de démarrage. Choisissez un autre onglet de démarrage dans Général avant de le masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è impostata come tab di avvio. Scegli un’altra tab di avvio in Generali prima di nasconderla."
          }
        }
      }
    },
