    "Tell me how long before you want the reminder, or say no reminder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag mir, wie lange vorher du die Erinnerung möchtest, oder sag keine Erinnerung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dime cuánto tiempo antes quieres el recordatorio o di ningún recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites combien de temps avant vous voulez le rappel ou dites aucun rappel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmi quanto tempo prima vuoi il promemoria oppure dimmi nessun promemoria."
          }
