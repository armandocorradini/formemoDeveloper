    "Sensitive Information" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrauliche Informationen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntas de seguridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informations sensibles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informazioni sensibili"
          }
        }
      }
    },
    "Sensitive Vault information is encrypted. Access to the Vault and password visibility may require Face ID, Touch ID, or your device passcode. ForMemo does not receive or store biometric data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensible Informationen im Tresor werden verschlüsselt. Für den Zugriff auf den Tresor und die Anzeige von Passwörtern können Face ID, Touch ID oder der Gerätecode erforderlich sein. ForMemo erhält oder speichert keine biometrischen Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información confidencial de la Caja fuerte está cifrada. El acceso a la Caja fuerte y la visualización de las contraseñas pueden requerir Face ID, Touch ID o el código de desbloqueo del dispositivo. ForMemo no recibe ni almacena datos biométricos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations sensibles du Coffre sont chiffrées. L’accès au Coffre et l’affichage des mots de passe peuvent nécessiter Face ID, Touch ID ou le code d’accès de votre appareil. ForMemo ne reçoit ni ne stocke de données biométriques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le informazioni sensibili della Cassaforte sono crittografate. L'accesso alla Cassaforte e la visualizzazione delle password possono richiedere Face ID, Touch ID oppure il codice di sblocco del dispositivo. ForMemo non riceve né memorizza dati biometrici."
          }
        }
      }
    },
