    "There are no ads, subscriptions, or in-app purchases. Just the pleasure of sharing a tool that may be useful to others." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, keine Abonnements und keine In-App-Käufe. Einfach die Freude daran, ein Werkzeug zu teilen, das auch anderen nützlich sein kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin publicidad, suscripciones ni compras dentro de la aplicación. Simplemente, el placer de compartir una herramienta que también pueda resultar útil a otras personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune publicité, aucun abonnement ni achat intégré. Simplement le plaisir de partager un outil qui pourrait être utile à d’autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente pubblicità, abbonamenti o acquisti in-app. Solo il piacere di condividere uno strumento che possa essere utile anche agli altri."
          }
        }
      }
    },
