      }
    },
    "Store and organize loyalty cards and tickets with barcodes or QR codes, holder information, notes, custom colors and optional logos always available inside the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern und organisieren Sie Kundenkarten und Tickets mit Barcodes oder QR-Codes, Inhaberinformationen, Notizen, benutzerdefinierten Farben und optionalen Logos, die jederzeit in der App verfügbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda y organiza tarjetas de fidelización y tickets con códigos de barras o códigos QR, información del titular, notas, colores personalizados y logotipos opcionales siempre disponibles dentro de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockez et organisez vos cartes de fidélité et tickets avec codes-barres ou codes QR, informations du titulaire, notes, couleurs personnalisées et logos optionnels toujours disponibles dans l’application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia e organizza carte fedeltà e tickets con codici a barre o codici QR, informazioni del titolare, note, colori personalizzati e loghi opzionali sempre disponibili all’interno dell’app."
          }
        }
      }
    },
    "Store and organize personal credentials including usernames, email addresses, websites, passwords, PINs, OTP secrets, notes, and custom secrets. Organize credentials into categories, mark favorites, generate strong passwords, and protect access using your device authentication." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern und verwalten Sie persönliche Anmeldedaten wie Benutzernamen, E-Mail-Adressen, Websites, Passwörter, PINs, OTP-Geheimnisse, Notizen und benutzerdefinierte Geheimnisse. Organisieren Sie Anmeldedaten in Kategorien, markieren Sie Favoriten, erstellen Sie sichere Passwörter und schützen Sie den Zugriff mit der Authentifizierung Ihres Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacene y organice credenciales personales como nombres de usuario, direcciones de correo electrónico, sitios web, contraseñas, PIN, secretos OTP, notas y secretos personalizados.Organice las credenciales por categorías, márquelas como favoritas, genere contraseñas seguras y proteja el acceso mediante la autenticación de su dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockez et organisez des identifiants personnels tels que des noms d'utilisateur, des adresses e-mail, des sites web, des mots de passe, des codes PIN, des secrets OTP, des notes et des secrets personnalisés.Organisez vos identifiants par catégories, marquez-les comme favoris, générez des mots de passe robustes et protégez l'accès grâce à l'authentification de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia e organizza credenziali personali come nomi utente, indirizzi email, siti web, password, PIN, segreti OTP, note e segreti personalizzati.Organizza le credenziali in categorie, contrassegnale come preferite, genera password robuste e proteggi l'accesso utilizzando l'autenticazione del dispositivo."
          }
        }
      }
    },
    "Store loyalty cards and tickets for quick access to QR codes and barcodes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie Kundenkarten und Tickets für den schnellen Zugriff auf QR-Codes und Barcodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tarjetas de fidelización y tickets para acceder rápidamente a códigos QR y códigos de barras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez vos cartes de fidélité et tickets pour un accès rapide aux codes QR et aux codes-barres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva carte fedeltà e tickets per accedere rapidamente a codici QR e codici a barre."
          }
        }
      }
    },
