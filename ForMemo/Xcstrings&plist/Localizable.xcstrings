    "Drag sections to choose their order. Hidden sections keep their position and return there when enabled again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Bereiche, um ihre Reihenfolge festzulegen. Ausgeblendete Bereiche behalten ihre Position und kehren dorthin zurück, wenn sie wieder aktiviert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las secciones para elegir su orden. Las secciones ocultas mantienen su posición y vuelven a ella cuando se activan de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les sections pour choisir leur ordre. Les sections masquées conservent leur position et y reviennent lorsqu’elles sont de nouveau activées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le sezioni per sceglierne l’ordine. Le sezioni nascoste mantengono la loro posizione e vi tornano quando vengono riattivate."
          }
        }
      }
    },
