    },
    "Yes. You can use Siri with the “Note ForMemo” command to create a new note." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Du kannst Siri mit dem Befehl „Note ForMemo“ verwenden, um eine neue Notiz zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
