    "When enabled, you'll be asked to confirm before deleting a task." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aktiviert ist, werden Sie vor dem Löschen einer Aufgabe um Bestätigung gebeten."
          }
        },
        "es" : {
          "stringUnit" : {
