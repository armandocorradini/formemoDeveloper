    "Import supported credential files from compatible password managers into the Vault to quickly transfer your existing accounts." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie unterstützte Anmeldedateien aus kompatiblen Passwort-Managern in den Tresor, um Ihre bestehenden Konten schnell zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe en la Caja fuerte archivos de credenciales compatibles procedentes de gestores de contraseñas compatibles para transferir rápidamente sus cuentas existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez dans le Coffre-fort des fichiers d'identifiants pris en charge provenant de gestionnaires de mots de passe compatibles afin de transférer rapidement vos comptes existants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa nella Cassaforte file di credenziali supportati provenienti da gestori di password compatibili per trasferire rapidamente gli account esistenti."
          }
        }
      }
    },
    "Import tasks from Apple Reminders, Calendar or CSV files in Settings > Data Management > Import & Export. Avoid duplicates and keep everything in one place.\n\nNote: attachments are not included in imports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie Aufgaben aus Apple Erinnerungen, dem Kalender oder CSV-Dateien unter Settings > Datenverwaltung > Import & Export. Vermeiden Sie Duplikate und behalten Sie alles an einem Ort.\n\nHinweis: Anhänge sind in Importen nicht enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa tareas desde Recordatorios de Apple, Calendario o archivos CSV en Settings > Gestión de datos > Importar y exportar. Evita duplicados y mantén todo en un solo lugar.\n\nNota: los archivos adjuntos no se incluyen en las importaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des tâches depuis Apple Rappels, Calendrier ou des fichiers CSV dans Settings > Gestion des données > Importer et exporter. Évitez les doublons et conservez tout au même endroit.\n\nRemarque : les pièces jointes ne sont pas incluses dans les importations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa attività da Apple Promemoria, Calendario o file CSV in Settings > Gestione dati > Importa ed esporta. Evita i duplicati e tieni tutto in un unico posto.\n\nNota: gli allegati non sono inclusi nelle importazioni."
          }
        }
      }
    },
