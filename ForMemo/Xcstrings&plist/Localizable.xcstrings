          }
        }
      }
    },
    "Checklists" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklisten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas de comprobación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklists"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklist"
          }
        }
      }
    },
    "Checklists help you organize tasks and items into sections. They can be used for travel, projects, work, home, events, personal activities and other needs. You can create them from scratch or start from a template, organize them into sections, and mark items as completed as you prepare them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Checklisten kannst du Aufgaben und Elemente in Abschnitte gliedern. Sie eignen sich für Reisen, Projekte, Arbeit, Haushalt, Veranstaltungen, persönliche Aktivitäten und vieles mehr. Du kannst sie von Grund auf erstellen oder eine Vorlage verwenden, sie in Abschnitte gliedern und Elemente als erledigt markieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas de comprobación te permiten organizar tareas y elementos por secciones. Puedes utilizarlas para viajes, proyectos, trabajo, hogar, eventos, actividades personales y mucho más. Puedes crearlas desde cero o a partir de una plantilla, organizarlas por secciones y marcar los elementos como completados mientras los preparas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les checklists vous permettent d’organiser les tâches et les éléments par sections. Elles peuvent être utilisées pour les voyages, les projets, le travail, la maison, les événements, les activités personnelles et bien plus encore. Vous pouvez les créer de zéro ou à partir d’un modèle, les organiser en sections et marquer les éléments comme terminés au fur et à mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklist ti aiutano a organizzare attività ed elementi in sezioni. Puoi utilizzarle per viaggi, progetti, lavoro, casa, eventi, attività personali e molto altro. Puoi crearle da zero o partire da un modello, organizzarle in sezioni e contrassegnare gli elementi come completati man mano che li prepari."
          }
        }
      }
    },
    "Checklists: %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklisten: %lld"
