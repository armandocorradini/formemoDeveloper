        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Puedes compartir notas con otras aplicaciones mediante las funciones de uso compartido del sistema compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
