    "%lld duplicate asset folder(s) detected.\n\nAutomatic recovery has been suspended because Asset Recovery Diagnostics is enabled.\n\nPress Repair to merge the folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld doppelte Asset-Ordner gefunden.\n\nDie automatische Wiederherstellung wurde angehalten, da die Diagnose der Asset-Wiederherstellung aktiviert ist.\n\nTippe auf „Reparieren“, um die Ordner zusammenzuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han detectado %lld carpetas de recursos duplicadas.\n\nLa recuperación automática se ha suspendido porque los diagnósticos de recuperación de recursos están activados.\n\nPulsa Reparar para fusionar las carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dossiers d’assets en double détectés.\n\nLa récupération automatique a été suspendue car les diagnostics de récupération des assets sont activés.\n\nTouchez Réparer pour fusionner les dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cartelle degli asset duplicate rilevate.\n\nIl recupero automatico è stato sospeso perché la diagnostica del recupero degli asset è attiva.\n\nTocca Ripara per unire le cartelle."
          }
        }
      }
    },
    "%lld duplicate asset folders detected.\n\n%@\n\nAutomatic recovery has been suspended because\nAsset Recovery Diagnostics is enabled.\n\nPress Repair to merge the folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld doppelte Ressourcenordner gefunden.\n\n%2$@\n\nDie automatische Wiederherstellung wurde angehalten, da die Diagnose für die Ressourcenwiederherstellung aktiviert ist.\n\nTippe auf „Reparieren“, um die Ordner zusammenzuführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld duplicate asset folders detected.\n\n%2$@\n\nAutomatic recovery has been suspended because\nAsset Recovery Diagnostics is enabled.\n\nPress Repair to merge the folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han detectado %1$lld carpetas de recursos duplicadas.\n\n%2$@\n\nLa recuperación automática se ha suspendido porque el diagnóstico de recuperación de recursos está activado.\n\nPulsa «Reparar» para combinar las carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld dossiers de ressources en double détectés.\n\n%2$@\n\nLa récupération automatique est suspendue, car les diagnostics de récupération des ressources sont activés.\n\nTouchez Réparer pour fusionner les dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevate %1$lld cartelle di risorse duplicate.\n\n%2$@\n\nIl recupero automatico è stato sospeso perché la diagnostica del recupero risorse è attiva.\n\nTocca «Ripara» per unire le cartelle."
          }
        }
      }
    },
