        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette récurrence créera %lld tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa ricorrenza creerà %lld attività."
          }
        }
      }
    },
    "This task could not be added to Calendar because Calendar does not support hourly recurrences." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufgabe konnte nicht zum Kalender hinzugefügt werden, da stündliche Wiederholungen nicht unterstützt werden."
          }
        },
        "es" : {
