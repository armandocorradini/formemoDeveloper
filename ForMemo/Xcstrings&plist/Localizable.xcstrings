    "Choose a password and confirm it. This password will be required only to restore Vault data from this backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein Passwort und bestätigen Sie es. Dieses Passwort wird nur zum Wiederherstellen der Tresordaten aus diesem Backup benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una contraseña y confírmala. Esta contraseña solo será necesaria para restaurar los datos de la Caja fuerte desde esta copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un mot de passe et confirmez-le. Ce mot de passe sera requis uniquement pour restaurer les données du Coffre à partir de cette sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
