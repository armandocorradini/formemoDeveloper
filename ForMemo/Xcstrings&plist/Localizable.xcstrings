    },
    "Yesterday" : {
      "comment" : "Title of a section of a list of tasks that is scheduled for tomorrow.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
