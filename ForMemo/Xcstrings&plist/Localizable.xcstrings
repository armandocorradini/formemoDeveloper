    "Enable ForMemo in iOS Settings > General > AutoFill & Passwords to securely use your saved Vault credentials in supported apps and websites. Copied passwords can be cleared automatically from the clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie ForMemo unter iOS-Einstellungen > Allgemein > AutoFill & Passwörter, um Ihre im Tresor gespeicherten Anmeldedaten sicher in unterstützten Apps und auf Websites zu verwenden. Kopierte Passwörter können automatisch aus der Zwischenablage entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ForMemo en Ajustes de iOS > General > Autorrelleno y contraseñas para utilizar de forma segura las credenciales guardadas en la Caja fuerte en aplicaciones y sitios web compatibles. Las contraseñas copiadas pueden eliminarse automáticamente del portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ForMemo dans Réglages iOS > Général > Remplissage automatique et mots de passe afin d'utiliser en toute sécurité les identifiants enregistrés dans le Coffre-fort sur les applications et sites web compatibles. Les mots de passe copiés peuvent être automatiquement supprimés du presse-papiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita ForMemo in Impostazioni di iOS > Generali > Compilazione automatica e password per utilizzare in modo sicuro le credenziali salvate nella Cassaforte nelle app e nei siti web supportati. Le password copiate possono essere rimosse automaticamente dagli appunti."
          }
        }
      }
    },
