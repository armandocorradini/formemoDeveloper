    "Occurrences will be generated through the selected date. If more than %lld are required, you can choose to create the first %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholungen werden bis zum ausgewählten Datum erstellt.\nWenn mehr als %lld Wiederholungen erforderlich sind, können Sie festlegen, dass nur die ersten %lld erstellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Occurrences will be generated through the selected date. If more than %1$lld are required, you can choose to create the first %2$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ocurrencias se generarán hasta la fecha seleccionada.\nSi se necesitan más de %lld ocurrencias, puedes elegir crear solo las primeras %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les occurrences seront générées jusqu’à la date sélectionnée.\nSi plus de %lld occurrences sont nécessaires, vous pouvez choisir de créer les %lld premières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le occorrenze verranno generate fino alla data selezionata.\nSe sono necessarie più di %lld occorrenze, puoi scegliere di creare solo le prime %lld."
          }
        }
      }
    },
