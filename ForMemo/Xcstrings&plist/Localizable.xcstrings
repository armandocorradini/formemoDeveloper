    "Reschedule" : {
      "comment" : "A label for a menu item that reschedules a task.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu planen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
