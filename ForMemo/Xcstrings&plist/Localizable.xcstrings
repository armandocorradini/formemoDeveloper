    "The selected secret, including its label and value, will be permanently removed from this credential. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Geheimnis einschließlich seiner Bezeichnung und seines Werts wird dauerhaft aus diesem Zugangseintrag entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El secreto seleccionado, incluida su etiqueta y su valor, se eliminará permanentemente de esta credencial. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le secret sélectionné, y compris son libellé et sa valeur, sera définitivement supprimé de cet identifiant. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il segreto selezionato, inclusi etichetta e valore, verrà rimosso definitivamente da questa credenziale. Questa azione non può essere annullata."
          }
        }
      }
    },
    "The series could not be extended. No changes were saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
