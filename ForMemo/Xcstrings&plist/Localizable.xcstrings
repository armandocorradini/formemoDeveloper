        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos adjuntos de las tareas completadas se eliminan automáticamente después del período seleccionado. Las tareas pendientes no se ven afectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
