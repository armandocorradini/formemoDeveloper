          }
        }
      }
    },
    "Open Settings > Appearance to personalize the app. Use Customize Task List to configure task rows, Customize Tab Bar to reorder tabs, and Tab Visibility to choose which tabs appear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Settings > Aussehen, um die App zu personalisieren. Verwenden Sie Aufgabenliste anpassen, um die Aufgabenzeilen zu konfigurieren, Tableiste anpassen, um die Tabs neu anzuordnen, und Tab-Sichtbarkeit, um auszuwählen, welche Tabs angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Settings > Apariencia para personalizar la aplicación. Usa Personalizar la lista de tareas para configurar las filas de tareas, Personalizar la barra de pestañas para reordenar las pestañas y Visibilidad de las pestañas para elegir cuáles aparecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Settings > Apparence pour personnaliser l’application. Utilisez Personnaliser la liste des tâches pour configurer les lignes des tâches, Personnaliser la barre d’onglets pour réorganiser les onglets et Visibilité des onglets pour choisir ceux qui apparaissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Settings > Aspetto per personalizzare l’app. Usa Personalizza elenco attività per configurare le righe delle attività, Personalizza barra tabs per riordinare le tab e Visibilità tab per scegliere quali tab visualizzare."
          }
        }
      }
    },
    "Open Source Licenses" : {
      "localizations" : {
