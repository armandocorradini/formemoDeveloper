    },
    "The password is incorrect. Enter the correct password to restore Vault, or continue without Vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort ist falsch. Gib das richtige Passwort ein, um den Tresor wiederherzustellen, oder fahre ohne Tresor fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña no es correcta. Introduce la contraseña correcta para restaurar la Caja fuerte o continúa sin la Caja fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est incorrect. Saisissez le mot de passe correct pour restaurer la Cassaforte ou continuez sans la Cassaforte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password non è corretta. Inserisci la password corretta per ripristinare la Cassaforte oppure continua senza Cassaforte."
          }
        }
      }
    },
    "The password is incorrect. Enter the correct password to restore Vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est incorrect. Saisissez le mot de passe correct pour restaurer le contenu de la Cassette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña no es correcta. Introduce la contraseña correcta para restaurar la Caja fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est incorrect. Saisissez le mot de passe correct pour restaurer le contenu de la Cassette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password non è corretta. Inserisci la password corretta per ripristinare la Cassaforte."
          }
        }
      }
    },
    "The password you entered cannot unlock the Vault data contained in this backup. Check the password and try again, or leave Vault unselected. The other data in the backup can be restored normally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das eingegebene Passwort kann die Tresordaten in diesem Backup nicht entsperren. Überprüfe das Passwort und versuche es erneut oder lasse den Tresor abgewählt. Die anderen Daten im Backup können normal wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña introducida no permite desbloquear los datos de la Caja fuerte incluidos en esta copia de seguridad. Comprueba la contraseña e inténtalo de nuevo, o deja la Caja fuerte sin seleccionar. El resto de los datos de la copia de seguridad se puede restaurar con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe saisi ne permet pas de déverrouiller les données de la Cassaforte contenues dans cette sauvegarde. Vérifiez le mot de passe et réessayez, ou laissez la Cassaforte désélectionnée. Les autres données de la sauvegarde peuvent être restaurées normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password inserita non consente di sbloccare i dati della Cassaforte contenuti in questo backup. Controlla la password e riprova, oppure lascia la Cassaforte non selezionata. Gli altri dati del backup possono essere ripristinati normalmente."
          }
        }
      }
    },
    "The recurrence rule and interval will be preserved. Past tasks and their completion status will remain unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederholungsregel und das Intervall bleiben erhalten.\nVergangene Auf zaben und ihr Abschlussstatus bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservarán la regla de repetición y el intervalo.\nLas tareas anteriores y su estado de finalización permanecerán sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La règle de récurrence et l’intervalle seront conservés.\nLes tâches passées et leur état d’achèvement resteront inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La regola di ricorrenza e l’intervallo verranno mantenuti.\nLe attività passate e il relativo stato di completamento resteranno invariati."
          }
        }
      }
    },
    "The selected image does not contain a readable barcode or QR code." : {
      "localizations" : {
