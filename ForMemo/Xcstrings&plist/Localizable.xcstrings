    "Notes lets you create, edit, organize, and store personal notes separately from your tasks. Notes are designed for information that does not need to be managed as a task." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Notes kannst du persönliche Notizen unabhängig von deinen Aufgaben erstellen, bearbeiten, organisieren und speichern. Notes ist für Informationen gedacht, die nicht als Aufgabe verwaltet werden müssen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas te permite crear, editar, organizar y almacenar notas personales por separado de tus tareas. Notas está pensado para información que no necesita gestionarse como una tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes vous permet de créer, de modifier, d’organiser et de stocker des notes personnelles séparément de vos tâches. Notes est conçu pour les informations qui n’ont pas besoin d’être gérées comme des tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note ti permette di creare, modificare, organizzare e archiviare note personali separatamente dalle tue attività. Note è pensato per le informazioni che non devono essere gestite come attività."
          }
        }
      }
    },
