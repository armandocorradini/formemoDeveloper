    "Export your tasks to Calendar, CSV or ICS format from Settings > Data Management > Import & Export to share or reuse them in other apps.\n\nNote: attachments are not included in exports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren Sie Ihre Aufgaben unter Settings > Datenverwaltung > Import & Export in den Kalender oder im CSV- bzw. ICS-Format, um sie zu teilen oder in anderen Apps weiterzuverwenden.\n\nHinweis: Anhänge sind in Exporten nicht enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta tus tareas a Calendario o en formato CSV o ICS desde Settings > Gestión de datos > Importar y exportar para compartirlas o reutilizarlas en otras aplicaciones.\n\nNota: los archivos adjuntos no se incluyen en las exportaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos tâches vers Calendrier ou aux formats CSV ou ICS depuis Settings > Gestion des données > Importer et exporter afin de les partager ou de les réutiliser dans d’autres applications.\n\nRemarque : les pièces jointes ne sont pas incluses dans les exportations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta le tue attività su Calendario, in formato CSV o ICS, da Settings > Gestione dati > Importa ed esporta per condividerle o riutilizzarle in altre app.\n\nNota: gli allegati non sono inclusi nelle esportazioni."
          }
        }
      }
    },
