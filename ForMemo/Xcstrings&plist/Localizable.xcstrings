    "To hide the Vault, first go to Settings > General > AutoFill & Passwords and turn off AutoFill Passwords and Passkeys. Then return here and turn off Vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Tresor auszublenden, gehe zuerst zu Einstellungen > Allgemein > Automatisch ausfüllen & Passwörter und deaktiviere das automatische Ausfüllen von Passwörtern und Passkeys. Kehre dann hierher zurück und deaktiviere den Tresor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ocultar la Caja fuerte, ve primero a Ajustes > General > Autorrelleno y contraseñas y desactiva Autorrelleno de contraseñas y claves de acceso. Después vuelve aquí y desactiva la Caja fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour masquer le coffre-fort, accédez d’abord à Réglages > Général > Remplissage automatique et mots de passe, puis désactivez le remplissage automatique des mots de passe et des clés d’accès. Revenez ensuite ici et désactivez le coffre-fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per nascondere la Cassaforte, vai prima in Impostazioni > Generali > Inserimento automatico e password e disattiva Inserimento automatico di password e passkey. Poi torna qui e disattiva Cassaforte."
          }
        }
      }
    },
    "To show the badge on the app icon and receive reminders and sound notifications, you must allow notifications for %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um das Badge auf dem App-Symbol anzuzeigen und Erinnerungen sowie akustische Benachrichtigungen zu erhalten, musst du Benachrichtigungen für %@ erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar la insignia en el icono de la app y recibir recordatorios y notificaciones sonoras, debes permitir las notificaciones para %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour afficher le badge sur l’icône de l’app et recevoir des rappels ainsi que des notifications sonores, vous devez autoriser les notifications pour %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per visualizzare il badge sull’icona dell’app e ricevere promemoria e notifiche sonore, devi consentire le notifiche per %@."
          }
        }
      }
    },
    "To use AutoFill, go to Settings > General > AutoFill & Passwords, then turn on ForMemo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um „Automatisch ausfüllen“ zu verwenden, gehe zu Einstellungen > Allgemein > Automatisch ausfüllen & Passwörter und aktiviere anschließend ForMemo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar Autorrelleno, ve a Ajustes > General > Autorrelleno y contraseñas y, a continuación, activa ForMemo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour utiliser le remplissage automatique, accédez à Réglages > Général > Remplissage automatique et mots de passe, puis activez ForMemo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per usare Inserimento automatico, vai in Impostazioni > Generali > Inserimento automatico e password, quindi attiva ForMemo."
          }
        }
      }
    },
