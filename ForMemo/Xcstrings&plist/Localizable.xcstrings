    "Find more information about ForMemo’s features and how to use them. Browse the frequently asked questions for detailed explanations and practical guidance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier finden Sie weitere Informationen zu den Funktionen von ForMemo und ihrer Verwendung. In den häufig gestellten Fragen finden Sie ausführliche Erklärungen und praktische Hinweise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre más información sobre las funciones de ForMemo y cómo utilizarlas. Consulta las preguntas frecuentes para obtener explicaciones detalladas y consejos prácticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez plus d’informations sur les fonctionnalités de ForMemo et leur utilisation. Consultez les questions fréquentes pour obtenir des explications détaillées et des conseils pratiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri di più sulle funzionalità di ForMemo e su come utilizzarle. Consulta le domande frequenti per approfondimenti e indicazioni pratiche."
          }
        }
      }
    },
