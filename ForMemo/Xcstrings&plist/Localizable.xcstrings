    "For each document, record where the original is physically stored, such as a drawer, cabinet, folder, or safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie für jedes Dokument an, wo das Original physisch aufbewahrt wird, beispielsweise in einer Schublade, einem Schrank, einem Ordner oder einem Safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cada documento, registra dónde se guarda físicamente el original, por ejemplo, en un cajón, un armario, una carpeta o una caja fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour chaque document, indiquez où l’original est physiquement conservé, par exemple dans un tiroir, une armoire, un dossier ou un coffre-fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogni documento, registra dove è conservato fisicamente l'originale, ad esempio in un cassetto, un armadio, una cartella o una cassaforte."
          }
        }
      }
    },
