    "Enable camera access in Settings to take photos." : {
      "comment" : "A message displayed in an alert that explains why the user needs to enable camera access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Kamerazugriff in den Einstellungen, um Fotos aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso a la cámara en Ajustes para tomar fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès à l’appareil photo dans les Réglages pour prendre des photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita l’accesso alla fotocamera nelle Impostazioni per scattare foto."
          }
        }
      }
    },
    "Enable Custom Order" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Reihenfolge aktivieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar Orden Personalizado"
          }
        },
        "fr" : {
          "stringUnit" : {
