    "Create a note to get started." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle eine Notiz, um zu beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una nota para empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
