    "Overview" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riepilogo"
          }
        }
      }
    },
    "Overview gives you a quick summary of the information that matters most. It provides an at-a-glance view of your tasks, documents, Wallet items, trip lists, and other useful information, helping you quickly understand the current status of your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übersicht bietet Ihnen eine schnelle Zusammenfassung der wichtigsten Informationen. Sie zeigt auf einen Blick Ihre Aufgaben, Dokumente, Wallet-Einträge, Reiselisten und weitere nützliche Informationen, damit Sie den aktuellen Stand Ihrer Daten sofort erkennen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Resumen te ofrece una visión rápida de la información más importante. Muestra de un vistazo tus tareas, documentos, elementos de la Caja fuerte, listas de viaje y otra información útil, ayudándote a conocer rápidamente el estado actual de tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Récapitulatif vous offre une vue d’ensemble rapide des informations les plus importantes. Il affiche en un coup d’œil vos tâches, documents, éléments du Wallet, listes de voyage et d’autres informations utiles afin de vous permettre de connaître rapidement l’état actuel de vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Riepilogo ti offre una panoramica immediata delle informazioni più importanti. Mostra a colpo d’occhio attività, documenti, elementi del Wallet, checklist di viaggio e altre informazioni utili, aiutandoti a conoscere rapidamente lo stato attuale dei tuoi dati."
          }
        }
      }
    },
