    "This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione non può essere annullata."
          }
        }
      }
    },
    "This attachment is not currently available on this device. Wait for iCloud synchronization and try again, or restore it from the device that originally deleted it. The item remains in Recently Deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anhang ist auf diesem Gerät derzeit nicht verfügbar. Warte auf die iCloud-Synchronisierung und versuche es erneut, oder stelle ihn auf dem Gerät wieder her, auf dem er ursprünglich gelöscht wurde. Das Objekt befindet sich weiterhin unter „Zuletzt gelöscht“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo adjunto no está disponible actualmente en este dispositivo. Espera a que se complete la sincronización con iCloud y vuelve a intentarlo, o restáuralo desde el dispositivo en el que se eliminó originalmente. El elemento sigue en «Eliminado recientemente»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette pièce jointe n’est pas disponible sur cet appareil pour le moment. Attendez la synchronisation avec iCloud, puis réessayez, ou restaurez-la depuis l’appareil sur lequel elle a été supprimée. L’élément se trouve toujours dans « Supprimés récemment »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo allegato non è attualmente disponibile su questo dispositivo. Attendi la sincronizzazione con iCloud e riprova oppure ripristinalo dal dispositivo su cui è stato eliminato originariamente. L’elemento si trova ancora in «Eliminati di recente»."
          }
        }
      }
    },
    "This attachment is shared with this recurrence. If you delete it, it will be removed from all past, current, and future occurrences and moved to Recently Deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anhang wird mit dieser Wiederholung geteilt. Wenn du ihn löschst, wird er aus allen vergangenen, aktuellen und zukünftigen Wiederholungen entfernt und in „Zuletzt gelöscht“ verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo adjunto se comparte con esta repetición. Si lo eliminas, se quitará de todas las ocurrencias pasadas, actuales y futuras y se moverá a Eliminados recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette pièce jointe est partagée avec cette récurrence. Si vous la supprimez, elle sera retirée de toutes les occurrences passées, présentes et futures, puis placée dans Éléments supprimés récemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo allegato è condiviso con questa ricorrenza. Se lo elimini, verrà rimosso da tutte le occorrenze passate, presenti e future e spostato in Eliminati di recente."
          }
        }
      }
    },
    "This extension requires more than %lld occurrences. Only the first %lld additional occurrences will be created." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Erweiterung sind mehr als %lld Wiederholungen erforderlich. Es werden nur die ersten %lld zusätzlichen Wiederholungen erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This extension requires more than %1$lld occurrences. Only the first %2$lld additional occurrences will be created."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ampliación requiere más de %lld ocurrencias. Solo se crearán las primeras %lld ocurrencias adicionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette extension nécessite plus de %lld occurrences. Seules les %lld premières occurrences supplémentaires seront créées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa estensione richiede più di %lld occorrenze. Verranno create solo le prime %lld occorrenze aggiuntive."
          }
        }
      }
    },
    "This extension will create %lld additional occurrences." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch diese Verlängerung werden %lld zusätzliche Wiederholungen erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ampliación creará %lld ocurrencias adicionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette prolongation créera %lld occurrences supplémentaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa estensione creerà %lld occorrenze aggiuntive."
          }
        }
      }
    },
    "This feature applies only to tasks created with Siri. The app analyzes the task title using a multilingual keyword system. Each category has its own keywords, and the best match is applied automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Funktion gilt nur für mit Siri erstellte Aufgaben. Die App analysiert den Titel mit einem mehrsprachigen Schlüsselwortsystem und weist automatisch die beste Kategorie zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta función se aplica solo a tareas creadas con Siri. La app analiza el título usando un sistema multilingüe de palabras clave y aplica automáticamente la mejor coincidencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fonctionnalité s’applique uniquement aux tâches créées avec Siri. L’app analyse le titre à l’aide d’un système de mots-clés multilingue et applique automatiquement la meilleure correspondance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa funzionalità si applica solo alle attività create con Siri. L’app analizza il titolo usando un sistema di parole chiave multilingua e applica automaticamente la corrispondenza migliore."
          }
        }
      }
    },
    "This Month" : {
      "comment" : "Title of the task period filter for tasks that occur in the current month.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Monat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mois-ci"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mese"
          }
        }
      }
    },
    "This occurrence" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wiederholung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ocurrencia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette occurrence"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa occorrenza"
          }
        }
      }
    },
    "This permanently deletes all ForMemo content from this device and its iCloud database, including tasks, notes, checklists, trips, documents, attachments, cards, tickets, vault items, and recently deleted items. The deletion will sync to your other devices. App settings and preferences are not reset. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle ForMemo-Inhalte auf diesem Gerät und in der iCloud-Datenbank endgültig gelöscht. Dazu gehören Aufgaben, Notizen, Checklisten, Reisen, Dokumente, Anhänge, Karten, Tickets, Tresoreinträge und zuletzt gelöschte Elemente. Die Löschung wird mit deinen anderen Geräten synchronisiert. App-Einstellungen und persönliche Anpassungen werden nicht zurückgesetzt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta operación elimina permanentemente todo el contenido de ForMemo de este dispositivo y de su base de datos de iCloud, incluidas las tareas, notas, listas de comprobación, viajes, documentos, archivos adjuntos, tarjetas, entradas, elementos de la caja fuerte y elementos eliminados recientemente. La eliminación se sincronizará con tus otros dispositivos. Los ajustes y las preferencias de la app no se restablecerán. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression définitive de tout le contenu ForMemo de cet appareil et de sa base de données iCloud inclut les tâches, les notes, les listes de contrôle, les voyages, les documents, les pièces jointes, les cartes, les billets, les éléments du coffre-fort et les éléments récemment supprimés. La suppression sera synchronisée sur vos autres appareils. Les réglages et les préférences de l’app ne seront pas réinitialisés. Cette opération est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione elimina definitivamente tutti i contenuti di ForMemo da questo dispositivo e dal relativo database iCloud, inclusi attività, note, checklist, viaggi, documenti, allegati, carte, biglietti, elementi della cassaforte ed elementi eliminati di recente. L'eliminazione verrà sincronizzata con gli altri dispositivi. Le impostazioni e le preferenze dell'app non verranno ripristinate. Questa operazione non può essere annullata."
          }
        }
      }
    },
    "This permanently removes all attachments. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Anhänge dauerhaft entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente todos los archivos adjuntos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement toutes les pièces jointes. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione elimina definitivamente tutti gli allegati. Non può essere annullata."
          }
        }
      }
    },
    "This provider does not support exporting credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
