    "Create a complete backup of tasks, notes, checklists, reminders, recurrence rules, tags, priorities, locations, cards and tickets, documents, attachments, Vault items and app settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein vollständiges Backup deiner Aufgaben, Notizen, Checklisten, Erinnerungen, Wiederholungsregeln, Tags, Prioritäten, Orte, Karten und Tickets, Dokumente, Anhänge, Tresorelemente und App-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una copia de seguridad completa de tus tareas, notas, listas de comprobación, recordatorios, reglas de repetición, etiquetas, prioridades, ubicaciones, tarjetas y entradas, documentos, archivos adjuntos, elementos de la Caja fuerte y ajustes de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une sauvegarde complète de vos tâches, notes, checklists, rappels, règles de récurrence, tags, priorités, lieux, cartes et billets, documents, pièces jointes, éléments du Coffre-fort et réglages de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un backup completo di attività, note, checklist, promemoria, regole di ricorrenza, tag, priorità, luoghi, carte e biglietti, documenti, allegati, elementi della Cassaforte e impostazioni dell’app."
          }
        }
      }
    },
