            "state" : "translated",
            "value" : "ForMemo konnte nicht auf deine Daten zugreifen. Öffne die App und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ForMemo couldn't access your data. Open the app and try again."
