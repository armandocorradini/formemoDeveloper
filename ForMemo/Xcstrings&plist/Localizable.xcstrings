          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo provider non supporta l'esportazione delle credenziali."
          }
        }
      }
    },
    "This recurrence requires more than %lld future occurrences. Only the first %lld future occurrences will be created in this operation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Wiederholung sind mehr als %lld zukünftige Wiederholungen erforderlich. Bei diesem Vorgang werden nur die ersten %lld zukünftigen Wiederholungen erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This recurrence requires more than %1$lld future occurrences. Only the first %2$lld future occurrences will be created in this operation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta recurrencia requiere más de %lld ocurrencias futuras. En esta operación solo se crearán las primeras %lld ocurrencias futuras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette récurrence nécessite plus de %lld occurrences futures. Seules les %lld premières occurrences futures seront créées lors de cette opération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa ricorrenza richiede più di %lld occorrenze future. In questa operazione verranno create solo le prime %lld occorrenze future."
          }
        }
      }
    },
    "This recurrence uses the previous recurrence system. Choose how many future occurrences to create, or choose an end date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wiederholung verwendet das vorherige Wiederholungssystem. Wähle die Anzahl der zu erstellenden zukünftigen Vorkommen oder ein Enddatum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta recurrencia utiliza el sistema de recurrencias anterior. Elige cuántas ocurrencias futuras crear o una fecha de finalización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette récurrence utilise l’ancien système de récurrence. Choisissez le nombre d’occurrences futures à créer ou une date de fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa ricorrenza utilizza il sistema di ricorrenza precedente. Scegli quante occorrenze future creare oppure una data di fine."
          }
        }
      }
    },
    "This recurrence will create %lld tasks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wiederholung erstellt %lld Aufgaben."
