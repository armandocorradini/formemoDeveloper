    "Overview" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riepilogo"
          }
        }
      }
    },
    "Overview gives you a quick summary of the information that matters most. It provides an at-a-glance view of your tasks, documents, Wallet items, Checklists, and other useful information, helping you quickly understand the current status of your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersicht bietet dir eine schnelle Zusammenfassung der wichtigsten Informationen. Sie zeigt deine Aufgaben, Dokumente, Wallet-Elemente, Checklisten und weitere nützliche Informationen auf einen Blick und hilft dir, den aktuellen Stand deiner Daten schnell zu erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumen ofrece una vista rápida de la información más importante. Muestra de un vistazo tus tareas, documentos, elementos de Wallet, listas de comprobación y otra información útil para ayudarte a conocer rápidamente el estado actual de tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu vous offre un résumé rapide des informations les plus importantes. Il présente en un coup d’œil vos tâches, documents, éléments du Wallet, checklists et autres informations utiles, afin de vous permettre de comprendre rapidement l’état actuel de vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riepilogo offre una panoramica rapida delle informazioni più importanti. Mostra a colpo d’occhio attività, documenti, elementi del Wallet, checklist e altre informazioni utili, aiutandoti a comprendere rapidamente lo stato attuale dei tuoi dati."
          }
        }
      }
    },
