    "Most features work offline. Cloud synchronization and some online services require an internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Funktionen sind offline verfügbar. Für die iCloud-Synchronisierung und einige Online-Dienste ist eine Internetverbindung erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de las funciones están disponibles sin conexión. La sincronización con iCloud y algunos servicios en línea requieren conexión a Internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des fonctionnalités sont disponibles hors ligne. La synchronisation iCloud et certains services en ligne nécessitent une connexion Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
