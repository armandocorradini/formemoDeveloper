    "Create strong passwords directly while adding or editing Vault credentials. Generated passwords help improve the security of your accounts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie sichere Passwörter direkt beim Hinzufügen oder Bearbeiten von Tresor-Anmeldedaten. Die generierten Passwörter tragen dazu bei, die Sicherheit Ihrer Konten zu erhöhen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree contraseñas seguras directamente al añadir o editar las credenciales de la Caja fuerte. Las contraseñas generadas ayudan a mejorar la seguridad de sus cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des mots de passe robustes directement lors de l'ajout ou de la modification des identifiants du Coffre-fort. Les mots de passe générés contribuent à renforcer la sécurité de vos comptes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea password robuste direttamente durante l'aggiunta o la modifica delle credenziali della Cassaforte. Le password generate contribuiscono a migliorare la sicurezza dei tuoi account."
          }
        }
      }
    },
