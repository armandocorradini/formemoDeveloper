    "This will import tasks from a CSV file." : {
      "comment" : "A message displayed in an alert when importing a CSV file.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies importiert Aufgaben aus einer CSV-Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto importará tareas desde un archivo CSV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela importera des tâches depuis un fichier CSV."
          }
        },
        "it" : {
          "stringUnit" : {
