    "Each Vault item can contain multiple custom secrets. You can store additional confidential information with your own labels alongside the main credential." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tresoreintrag kann mehrere benutzerdefinierte Geheimnisse enthalten.\nSie können zusätzliche vertrauliche Informationen mit eigenen Bezeichnungen zusammen mit den Hauptanmeldedaten speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada elemento de la Caja fuerte puede contener varios secretos personalizados.\nPuede almacenar información confidencial adicional con sus propias etiquetas junto a la credencial principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément du Coffre-fort peut contenir plusieurs secrets personnalisés.\nVous pouvez enregistrer des informations confidentielles supplémentaires avec vos propres libellés, en plus de l'identifiant principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento della Cassaforte può contenere più segreti personalizzati.\nPuoi archiviare informazioni riservate aggiuntive con etichette personalizzate insieme alla credenziale principale."
          }
        }
      }
    },
