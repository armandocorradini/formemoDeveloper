    "Check permissions, accuracy, and whether the task is actively monitored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Berechtigungen, Genauigkeit und ob die Aufgabe aktiv überwacht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba los permisos, la precisión y que la tarea esté siendo monitorizada activamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les autorisations, la précision et si la tâche est activement surveillée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica i permessi, la precisione e che l’attività sia attivamente monitorata."
          }
        }
      }
    },
    "Check system permissions, Focus modes, and app settings. Notifications are only scheduled when valid and allowed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Systemberechtigungen, Fokusmodi und App-Einstellungen. Benachrichtigungen werden nur geplant, wenn sie gültig und erlaubt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba los permisos del sistema, los modos de concentración y los ajustes de la app. Las notificaciones solo se programan cuando son válidas y están permitidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les autorisations système, les modes Concentration et les réglages de l’app. Les notifications ne sont planifiées que lorsqu’elles sont valides et autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica i permessi di sistema, le modalità Focus e le impostazioni dell’app. Le notifiche vengono pianificate solo quando sono valide e consentite."
          }
        }
      }
    },
    "Check upcoming tasks, reminders and due dates with Siri." : {
