    },
    "You’ll receive an alert at the task’s deadline. The app badge updates when tasks reach their deadlines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erhalten zum Fälligkeitszeitpunkt der Aufgabe eine Meldung. Das App-Symbol wird aktualisiert, sobald Aufgaben fällig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás un aviso cuando llegue la fecha límite de la tarea. El indicador de la app se actualiza cuando las tareas llegan a su fecha límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevrez une alerte à l’échéance de la tâche. Le badge de l’app est mis à jour lorsque les tâches arrivent à leur échéance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverai un avviso alla scadenza dell’attività. Il badge dell’app si aggiorna quando le attività raggiungono la scadenza."
          }
        }
      }
    },
    "Your appearance preferences, navigation settings, badge settings and other supported preferences can be included in backups and restored independently from your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einstellungen für das Erscheinungsbild, die Navigation und die Kennzeichen sowie weitere unterstützte Einstellungen können in Backups aufgenommen und unabhängig von deinen Daten wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus preferencias de apariencia, ajustes de navegación, ajustes de los distintivos y otras preferencias compatibles pueden incluirse en las copias de seguridad y restaurarse por separado de tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos préférences d’apparence, paramètres de navigation, réglages des badges et autres préférences prises en charge peuvent être inclus dans les sauvegardes et restaurés indépendamment de vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le preferenze relative all’aspetto, le impostazioni di navigazione, quelle dei badge e le altre preferenze supportate possono essere incluse nei backup e ripristinate separatamente dai tuoi dati."
          }
        }
      }
    },
    "Your changes could not be saved. Please try again." : {
      "localizations" : {
