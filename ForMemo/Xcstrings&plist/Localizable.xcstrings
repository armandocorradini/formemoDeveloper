    "Get notified when you arrive at a place. Associate a location with a task and receive a reminder automatically at the right moment." : {
      "comment" : "Title of a quick guide item for location-based reminders.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine Benachrichtigung, wenn du an einem Ort ankommst.\nVerknüpfe einen Ort mit einer Aufgabe und erhalte automatisch eine Erinnerung zum richtigen Zeitpunkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe una notificación cuando llegues a un lugar.\nAsocia una ubicación a una tarea y recibe automáticamente un recordatorio en el momento adecuado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification lorsque vous arrivez à un endroit.\nAssociez un lieu à une tâche et recevez automatiquement un rappel au bon moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando arrivi in un luogo.\nAssocia una posizione a un’attività e ricevi automaticamente un promemoria al momento giusto."
