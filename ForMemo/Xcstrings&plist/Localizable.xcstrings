    "One or more attachments are missing from this device. Make sure the original files are available again through iCloud or your backup before deleting this task." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder mehrere Anhänge fehlen auf diesem Gerät. Stellen Sie sicher, dass die Originaldateien wieder über iCloud oder Ihr Backup verfügbar sind, bevor Sie diese Aufgabe löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan uno o varios archivos adjuntos en este dispositivo. Asegúrate de que los archivos originales vuelvan a estar disponibles a través de iCloud o de tu copia de seguridad antes de eliminar esta tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ou plusieurs pièces jointes sont absentes de cet appareil. Assurez-vous que les fichiers d’origine sont de nouveau disponibles via iCloud ou votre sauvegarde avant de supprimer cette tâche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno o più allegati mancano da questo dispositivo. Assicurati che i file originali siano nuovamente disponibili tramite iCloud o il tuo backup prima di eliminare questa attività."
          }
        }
      }
    },
    "One or more attachments could not be moved to Recently Deleted. Make sure they are downloaded on this device, wait for any download to finish, then try again. Nothing was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Anhang konnte nicht nach „Zuletzt gelöscht“ verschoben werden. Vergewissere dich, dass die Anhänge auf dieses Gerät geladen wurden. Warte, bis alle Downloads abgeschlossen sind, und versuche es erneut. Es wurde nichts gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido mover uno o varios archivos adjuntos a «Eliminado recientemente». Comprueba que estén descargados en este dispositivo. Espera a que terminen las descargas en curso y vuelve a intentarlo. No se ha eliminado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déplacer une ou plusieurs pièces jointes vers « Supprimés récemment ». Vérifiez qu’elles sont téléchargées sur cet appareil. Attendez la fin des téléchargements en cours, puis réessayez. Aucun élément n’a été supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile spostare uno o più allegati in “Eliminati di recente”. Verifica che siano scaricati su questo dispositivo. Attendi il completamento di eventuali download, poi riprova. Non è stato eliminato nulla."
          }
        }
      }
    },
    "One or more attachments for this task are not available on this device. Wait until they are available before deleting the task." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder mehrere Anhänge für diese Aufgabe sind auf diesem Gerät nicht verfügbar. Warte, bis sie verfügbar sind, bevor du die Aufgabe löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno o varios archivos adjuntos de esta tarea no están disponibles en este dispositivo. Espera a que estén disponibles antes de eliminar la tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ou plusieurs pièces jointes de cette tâche ne sont pas disponibles sur cet appareil. Attendez qu’elles le soient avant de supprimer la tâche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno o più allegati per questa attività non sono disponibili su questo dispositivo. Attendi che siano disponibili prima di eliminare l’attività."
          }
        }
      }
    },
    "One or more attachments have not finished downloading to this device. Wait for the download to complete, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Anhang wurde noch nicht vollständig auf dieses Gerät geladen. Warte, bis der Download abgeschlossen ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no ha terminado la descarga de uno o varios archivos adjuntos en este dispositivo. Espera a que termine y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement d’une ou plusieurs pièces jointes sur cet appareil n’est pas terminé. Attendez la fin du téléchargement, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download di uno o più allegati su questo dispositivo non è ancora terminato. Attendi il completamento, poi riprova."
          }
        }
      }
    },
    "Only attachments of completed tasks are deleted automatically if Auto-delete attachments is enabled in Settings > Data Management." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Anhänge abgeschlossener Aufgaben werden automatisch gelöscht, wenn Anhänge automatisch löschen unter Settings > Datenverwaltung aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se eliminan automáticamente los archivos adjuntos de las tareas completadas si la opción Eliminar automáticamente los archivos adjuntos está activada en Settings > Gestión de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les pièces jointes des tâches terminées sont supprimées automatiquement si l’option Supprimer automatiquement les pièces jointes est activée dans Settings > Gestion des données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo gli allegati delle attività completate vengono eliminati automaticamente se l’opzione Elimina automaticamente gli allegati è attiva in Settings > Gestione dati."
