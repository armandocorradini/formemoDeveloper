    },
    "This will permanently erase all your data from this app and iCloud, including tasks, notes, documents, attachments, checklists, cards, tickets, and vault items. Your data will also be removed from any other devices. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle deine Daten aus dieser App und iCloud dauerhaft gelöscht, einschließlich Aufgaben, Notizen, Dokumenten, Anhängen, Checklisten, Karten, Tickets und Tresorelementen. Deine Daten werden auch von allen anderen Geräten entfernt. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta operación eliminará permanentemente todos tus datos de esta app y de iCloud, incluidas las tareas, notas, documentos, archivos adjuntos, listas de comprobación, tarjetas, entradas y elementos de la Caja fuerte. Tus datos también se eliminarán de los demás dispositivos. Esta operación no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération effacera définitivement toutes vos données de cette app et d’iCloud, notamment les tâches, notes, documents, pièces jointes, checklists, cartes, billets et éléments du Coffre-fort. Vos données seront également supprimées de tous vos autres appareils. Cette opération est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione eliminerà definitivamente tutti i dati da questa app e da iCloud, incluse attività, note, documenti, allegati, checklist, carte, biglietti ed elementi della Cassaforte. I dati verranno rimossi anche dagli altri dispositivi. Questa operazione non può essere annullata."
          }
        }
      }
    },
