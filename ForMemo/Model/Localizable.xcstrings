    "Store and organize loyalty cards and tickets with barcodes or QR codes, holder information, notes, custom colors and optional logos always available inside the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern und organisieren Sie Kundenkarten und Tickets mit Barcodes oder QR-Codes, Inhaberinformationen, Notizen, benutzerdefinierten Farben und optionalen Logos, die jederzeit in der App verfügbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda y organiza tarjetas de fidelización y tickets con códigos de barras o códigos QR, información del titular, notas, colores personalizados y logotipos opcionales siempre disponibles dentro de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockez et organisez vos cartes de fidélité et tickets avec codes-barres ou codes QR, informations du titulaire, notes, couleurs personnalisées et logos optionnels toujours disponibles dans l’application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia e organizza carte fedeltà e tickets con codici a barre o codici QR, informazioni del titolare, note, colori personalizzati e loghi opzionali sempre disponibili all’interno dell’app."
          }
        }
      }
    },
