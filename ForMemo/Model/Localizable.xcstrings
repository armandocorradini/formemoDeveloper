    "Every task automatically generates a notification when it becomes overdue. Add additional reminders, location alerts and early notifications up to 7 days in advance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aufgabe erzeugt automatisch eine Benachrichtigung, wenn sie überfällig wird. Sie können zusätzliche Erinnerungen, standortbasierte Benachrichtigungen und Vorabbenachrichtigungen bis zu 7 Tage im Voraus hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarea genera automáticamente una notificación cuando vence. Puedes añadir recordatorios adicionales, alertas basadas en la ubicación y notificaciones anticipadas de hasta 7 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque tâche génère automatiquement une notification lorsqu’elle devient en retard. Vous pouvez ajouter des rappels supplémentaires, des alertes basées sur la localisation et des notifications anticipées jusqu’à 7 jours à l’avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni attività genera automaticamente una notifica quando diventa scaduta. Puoi aggiungere promemoria aggiuntivi, notifiche basate sulla posizione e notifiche anticipate fino a 7 giorni prima."
          }
        }
      }
