    "Location reminders require \"Always Allow\" location access and must be enabled in Settings." : {
      "comment" : "A warning message that appears when the user tries to enable location reminders but has not allowed location access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortbasierte Erinnerungen erfordern den Standortzugriff „Immer erlauben“ und müssen in den Einstellungen aktiviert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios basados en la ubicación requieren acceso a la ubicación configurado como «Permitir siempre» y deben estar activados en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels basés sur la position nécessitent un accès à la localisation réglé sur « Toujours autoriser » et doivent être activés dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria basati sulla posizione richiedono l’accesso alla posizione impostato su “Sempre” e devono essere abilitati nelle Impostazioni."
          }
        }
      }
    },
    "Location reminders require \"Always Allow\" location access. Please enable it in Settings." : {
      "localizations" : {
