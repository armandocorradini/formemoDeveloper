    "Select your preferred navigation app in Settings. Open task locations with your favorite navigation app or choose which app to use each time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie in den Einstellungen Ihre bevorzugte Navigations-App aus. Öffnen Sie Aufgabenstandorte mit Ihrer bevorzugten Navigations-App oder entscheiden Sie jedes Mal, welche App verwendet werden soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona tu aplicación de navegación preferida en Ajustes. Abre las ubicaciones de las tareas con tu aplicación de navegación favorita o elige qué aplicación utilizar cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez votre application de navigation préférée dans les Réglages. Ouvrez les emplacements des tâches avec votre application de navigation favorite ou choisissez l’application à utiliser à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona la tua app di navigazione preferita nelle Impostazioni. Apri le posizioni delle attività con la tua app di navigazione preferita oppure scegli ogni volta quale app utilizzare."
          }
        }
      }
    },
