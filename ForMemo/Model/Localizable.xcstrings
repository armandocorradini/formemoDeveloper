    "Instantly filter tasks by category, priority, due date period, overdue status or tasks without a deadline. Combine filters to focus only on what matters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtern Sie Aufgaben sofort nach Kategorie, Priorität, Fälligkeitszeitraum, Überfälligkeitsstatus oder fehlendem Fälligkeitsdatum. Kombinieren Sie mehrere Filter, um sich auf das Wesentliche zu konzentrieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra instantáneamente las tareas por categoría, prioridad, período de vencimiento, estado de vencimiento o ausencia de fecha límite. Combina varios filtros para centrarte solo en lo que importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrez instantanément les tâches par catégorie, priorité, période d’échéance, statut de retard ou absence de date d’échéance. Combinez plusieurs filtres pour vous concentrer sur l’essentiel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra immediatamente le attività per categoria, priorità, periodo di scadenza, stato di scadenza o assenza di una scadenza. Combina più filtri per concentrarti solo su ciò che conta davvero."
          }
        }
      }
    },
