    "Most features work offline. Weather forecasts, cloud synchronization, and some online services require an internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Funktionen arbeiten offline. Wettervorhersagen, Cloud-Synchronisierung und einige Online-Dienste erfordern eine Internetverbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de las funciones funcionan sin conexión. Las previsiones meteorológicas, la sincronización en la nube y algunos servicios en línea requieren conexión a Internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des fonctionnalités fonctionnent hors ligne. Les prévisions météo, la synchronisation cloud et certains services en ligne nécessitent une connexion Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte delle funzionalità funziona offline. Le previsioni meteo, la sincronizzazione cloud e alcuni servizi online richiedono una connessione Internet."
          }
        }
      }
    },
