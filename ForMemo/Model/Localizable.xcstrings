    "Weather data is provided by Open-Meteo. Different weather providers may use different forecasting models and update schedules." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wetterdaten werden von Open-Meteo bereitgestellt. Verschiedene Wetterdienste können unterschiedliche Vorhersagemodelle und Aktualisierungsintervalle verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos meteorológicos son proporcionados por Open-Meteo. Diferentes proveedores meteorológicos pueden utilizar distintos modelos de predicción y frecuencias de actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données météo sont fournies par Open-Meteo. Différents fournisseurs météo peuvent utiliser des modèles de prévision et des fréquences de mise à jour différents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati meteo sono forniti da Open-Meteo. Diversi fornitori di servizi meteorologici possono utilizzare modelli previsionali e frequenze di aggiornamento differenti."
          }
        }
      }
    },
