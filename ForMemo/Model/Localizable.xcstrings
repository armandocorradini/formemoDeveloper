    "No. iCloud synchronization and manual backups are separate features. Backups are still recommended for additional safety and portability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Die iCloud-Synchronisierung und manuelle Backups sind getrennte Funktionen. Backups werden weiterhin für zusätzliche Sicherheit und Portabilität empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. La sincronización de iCloud y las copias de seguridad manuales son funciones independientes. Las copias de seguridad siguen siendo recomendables para mayor seguridad y portabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. La synchronisation iCloud et les sauvegardes manuelles sont des fonctionnalités distinctes. Les sauvegardes restent recommandées pour plus de sécurité et de portabilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. La sincronizzazione iCloud e i backup manuali sono funzionalità separate. I backup sono comunque consigliati per maggiore sicurezza e portabilità."
          }
        }
      }
    },
