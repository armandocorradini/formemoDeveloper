    },
    "Yes. You can save multiple cards or tickets from the same store, event, or provider and distinguish them using the holder field or custom notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Sie können mehrere Karten oder Tickets desselben Geschäfts, derselben Veranstaltung oder desselben Anbieters speichern und sie mithilfe des Inhaberfelds oder benutzerdefinierter Notizen unterscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Puedes guardar varias tarjetas o tickets de la misma tienda, evento o proveedor y diferenciarlas utilizando el campo del titular o notas personalizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Vous pouvez enregistrer plusieurs cartes ou tickets provenant du même magasin, événement ou fournisseur et les distinguer grâce au champ du titulaire ou à des notes personnalisées."
          }
        },
        "it" : {
          "stringUnit" : {
