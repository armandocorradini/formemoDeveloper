          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Vous pouvez utiliser l’appareil photo de votre appareil pour numériser des pages et les joindre directement à une tâche."
          }
        },
        "it" : {
