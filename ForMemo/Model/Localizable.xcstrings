    "Powerful Filters" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistungsstarke Filter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtros avanzados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtres avancés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtri avanzati"
          }
        }
      }
    },
    "Powerful Filters help you quickly find tasks by category, priority, due date period, overdue status, or tasks without a deadline. Multiple filters can be combined at the same time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistungsstarke Filter helfen Ihnen, Aufgaben schnell nach Kategorie, Priorität, Fälligkeitszeitraum, Überfälligkeitsstatus oder fehlendem Fälligkeitsdatum zu finden. Mehrere Filter können gleichzeitig kombiniert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los filtros avanzados te ayudan a encontrar rápidamente tareas por categoría, prioridad, período de vencimiento, estado de vencimiento o ausencia de fecha límite. Se pueden combinar varios filtros al mismo tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres avancés vous permettent de trouver rapidement des tâches par catégorie, priorité, période d’échéance, statut de retard ou absence de date d’échéance. Plusieurs filtres peuvent être combinés simultanément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Filtri avanzati ti aiutano a trovare rapidamente le attività in base a categoria, priorità, periodo di scadenza, stato di scadenza o assenza di una scadenza. È possibile combinare più filtri contemporaneamente."
          }
        }
      }
    },
