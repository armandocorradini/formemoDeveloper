    "Keep track of important documents, expiry dates, notes and reminders. Receive notifications before documents expire." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten Sie wichtige Dokumente, Ablaufdaten, Notizen und Erinnerungen im Blick. Erhalten Sie Benachrichtigungen, bevor Dokumente ablaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realiza un seguimiento de documentos importantes, fechas de vencimiento, notas y recordatorios. Recibe notificaciones antes de que los documentos expiren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les documents importants, les dates d’expiration, les notes et les rappels. Recevez des notifications avant l’expiration de vos documents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia dei documenti importanti, delle date di scadenza, delle note e dei promemoria. Ricevi notifiche prima della scadenza dei documenti."
          }
        }
