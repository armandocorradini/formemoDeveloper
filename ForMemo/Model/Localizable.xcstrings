    "Trip Lists" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiselisten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas de Viaje"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listes de Voyage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste Viaggio"
          }
        }
      }
    },
    "Trip Lists help you organize everything you need to take with you on your travels. You can create them from scratch or start from a template, organize them into sections, and mark items as completed as you prepare them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiselisten helfen Ihnen dabei, alles zu organisieren, was Sie mitnehmen möchten. Sie können sie von Grund auf erstellen oder eine Vorlage verwenden, in Abschnitte unterteilen und Elemente beim Packen als erledigt markieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Listas de Viaje te ayudan a organizar todo lo que necesitas llevar contigo. Puedes crearlas desde cero o partir de una plantilla, organizarlas en secciones y marcar los elementos como completados a medida que los preparas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Listes de Voyage vous aident à organiser tout ce que vous devez emporter avec vous. Vous pouvez les créer à partir de zéro ou à partir d’un modèle, les organiser en sections et cocher les éléments au fur et à mesure de leur préparation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Liste Viaggio ti aiutano a organizzare tutto ciò che devi portare con te. Puoi crearle da zero o partire da un modello, suddividerle in sezioni e contrassegnare gli elementi man mano che vengono preparati."
          }
        }
      }
    },
    "Trip Name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
