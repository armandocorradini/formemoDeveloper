    "Quickly scan loyalty cards and tickets using the device camera or import ticket images to automatically save barcode and QR code information into your Wallet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie Kundenkarten und Tickets schnell mit der Gerätekamera oder importieren Sie Ticketbilder, um Barcode- und QR-Code-Informationen automatisch in Ihrem Wallet zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea rápidamente tarjetas de fidelización y tickets utilizando la cámara del dispositivo o importa imágenes de tickets para guardar automáticamente la información de códigos de barras y códigos QR en tu Wallet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez rapidement des cartes de fidélité et des tickets à l’aide de l’appareil photo de l’appareil ou importez des images de tickets afin d’enregistrer automatiquement les informations de codes-barres et de codes QR dans votre Wallet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona rapidamente carte fedeltà e tickets utilizzando la fotocamera del dispositivo oppure importa immagini di tickets per salvare automaticamente nel Wallet le informazioni di codici a barre e codici QR."
          }
        }
      }
    },
