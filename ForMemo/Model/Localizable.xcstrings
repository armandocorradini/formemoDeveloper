    "Use simple voice commands with Siri to create, search and check your reminders in seconds." : {
      "comment" : "A description of the Siri feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einfache Sprachbefehle mit Siri, um deine Erinnerungen in Sekunden zu erstellen, zu durchsuchen und zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa comandos de voz simples con Siri para crear, buscar y revisar tus recordatorios en segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez de simples commandes vocales avec Siri pour créer, rechercher et consulter vos rappels en quelques secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa semplici comandi vocali con Siri per creare, cercare e controllare i tuoi promemoria in pochi secondi."
          }
        }
      }
    },
