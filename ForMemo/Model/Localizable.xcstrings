    "Check system permissions, Focus modes, and app settings. Notifications are only scheduled when valid and allowed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Systemberechtigungen, Fokusmodi und App-Einstellungen. Benachrichtigungen werden nur geplant, wenn sie gültig und erlaubt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
